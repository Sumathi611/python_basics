#  We have a set that contains roll numbers of candidates who have applied for an event. Out of the applied candidates, 
# few have submitted their application forms, and we have registered their details in a dictionary given below.
#  Print the roll numbers of the candidates who have submitted their application forms and also the ones who are yet to submit it.
roll_numbers = {12, 7, 15, 23, 32, 30}
student_details = {12:'Judy', 30:'Shane', 23:'Aaron'}
c_set={x for x in roll_numbers if x in student_details.keys()}
p_set={x for x in roll_numbers if x not in student_details.keys()}
print(f'Completed Applications: {c_set}')
print(f'Pending Applications: {p_set}')

#### Output:
    # Completed Applications:  {12, 30, 23}
   # Pending Applications:  {32, 15, 7}

# "We have a list of companies with their face values in the stock market. Now, I want to get the company's name along with its face value for the company, 
# which has the maximum and the minimum face values. I also want you all to sort this list based on face values in increasing order.
stock_market ={'AXIS BANK' : 7,
'BHARTI AIRTEL' : 5,
'COAL INDIA' : 10,
'ITC' : 1,
'TCS' : 3,
'L&T' : 2,
'RELIANCE' : 9,
'KOTAK BANK' : 8,
'AMERICAN EXPRESS' : 11}
stock_market_min_key = min(stock_market, key=stock_market.get)
stock_market_min_value=stock_market[stock_market_min_key]
lst_min=[stock_market_min_value,stock_market_min_key]
print(lst_min)
stock_market_max_key = max(stock_market, key=stock_market.get)
stock_market_max_value=stock_market[stock_market_max_key]
lst_max=[stock_market_max_value,stock_market_max_key]
print(lst_max)
swapped_list =[(value,key) for key, value in stock_market.items()]
swapped_list.sort()
print(swapped_list)

# Write a program to print all the numbers between 100 to 300 (both included) such that each digit of the given number is an even number.
